# SaleBari — Apache configuration for cPanel shared hosting.
# Remember to enable "Show Hidden Files (dotfiles)" in cPanel File Manager,
# or this file will be invisible after upload.

Options -Indexes
DirectoryIndex index.html index.php

# Application code is never served directly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|install|data)/ - [F,L]
  RewriteRule ^admin/_chrome\.php$ - [F,L]

  # One address for the site: www.salebari.com -> salebari.com (301)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Old WordPress / WooCommerce addresses that Google still has indexed
  RewriteRule ^product-category/(.*)$ legacy.php?t=cat&p=$1 [L]
  RewriteRule ^product/(.*)$ legacy.php?t=product&p=$1 [L]
  RewriteRule ^(shop|cart|checkout|my-account|wishlist|compare)(?:/.*)?$ legacy.php?t=$1 [L]
  RewriteRule ^(?:category|tag)/ legacy.php?t=blog [L]
  RewriteRule ^(?:wp-admin|wp-login\.php|wp-content|wp-includes|wp-json|xmlrpc\.php|feed|comments)(?:/.*)?$ - [G,L]

  # Sitemaps (built from the database)
  RewriteRule ^sitemap_index\.xml$ sitemap.php?type=index [L]
  RewriteRule ^sitemap\.xml$       sitemap.php?type=index [L]
  RewriteRule ^sitemap-([a-z]+)\.xml$ sitemap.php?type=$1 [L]

  # Pretty detail-page URLs (like BDStall). Stalls, malls and brands are numbered from 1001.
  RewriteRule ^details/(?:[^/]*-)?([0-9]+)/?$        product.php?pid=$1     [L,QSA]
  RewriteRule ^stall/(?:[^/]*-)?([0-9]{4,})/?$       stall/show.php?sid=$1  [L,QSA]
  RewriteRule ^market/(?:[^/]*-)?([0-9]{4,})/?$      market/show.php?mid=$1 [L,QSA]
  RewriteRule ^brand/(?:[^/]*-)?([0-9]{4,})/?$       brand/show.php?bid=$1  [L,QSA]

  # Old category / listing addresses -> redirected to the new clean ones by catalog.php
  RewriteCond %{QUERY_STRING} (?:^|&)(?:cat|sub)=([A-Za-z0-9]+)
  RewriteRule ^category\.html$ catalog.php?legacy=%1 [L]
  RewriteCond %{QUERY_STRING} (?:^|&)item=([A-Za-z0-9]+)
  RewriteRule ^listing\.html$ catalog.php?legacy=%1 [L]

  # Category pages: /car-bike/  /car-bike/accessories/  /car-bike/accessories/scratch-remover/
  # (only for paths that are not real files or folders)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/?$ catalog.php?c1=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/?$ catalog.php?c1=$1&c2=$2 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/([a-z0-9-]+)/?$ catalog.php?c1=$1&c2=$2&c3=$3 [L,QSA]
</IfModule>

<FilesMatch "^(config\.php)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|sqlite|log|md)$">
  Require all denied
</FilesMatch>

# Cache static assets. CSS/JS links carry ?v=N, so a long cache is safe: bumping N fetches the new file.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript        "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/gif              "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json application/ld+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|svg|jpe?g|png|webp|gif|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # two read-only PHP endpoints used on every page: a short cache is fine
  <FilesMatch "^(category-urls|tracking-config)\.php$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
