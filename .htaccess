# SaleBari — Apache configuration for cPanel shared hosting.
# Remember to enable "Show Hidden Files (dotfiles)" in cPanel File Manager,
# or this file will be invisible after upload.

Options -Indexes
DirectoryIndex index.html index.php

# Application code is never served directly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|install|data)/ - [F,L]
  RewriteRule ^admin/_chrome\.php$ - [F,L]

  # Pretty detail-page URLs (like BDStall). Stalls, malls and brands are numbered from 1001.
  RewriteRule ^details/(?:[^/]*-)?([0-9]+)/?$        product.php?pid=$1     [L,QSA]
  RewriteRule ^stall/(?:[^/]*-)?([0-9]{4,})/?$       stall/show.php?sid=$1  [L,QSA]
  RewriteRule ^market/(?:[^/]*-)?([0-9]{4,})/?$      market/show.php?mid=$1 [L,QSA]
  RewriteRule ^brand/(?:[^/]*-)?([0-9]{4,})/?$       brand/show.php?bid=$1  [L,QSA]
</IfModule>

<FilesMatch "^(config\.php)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|sqlite|log|md)$">
  Require all denied
</FilesMatch>

# Cache static assets; HTML stays fresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/svg+xml          "access plus 1 month"
  ExpiresByType image/jpeg             "access plus 1 month"
  ExpiresByType image/png              "access plus 1 month"
  ExpiresByType image/webp             "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

AddDefaultCharset UTF-8
